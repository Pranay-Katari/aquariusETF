# Local-only demo. Never expose APP_MODE=demo on a public host.
APP_MODE=demo
# Omit DATABASE_URL and DATA_DIR for repository-local defaults.
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT:PASSWORD@HOST:5432/postgres?sslmode=require
# DATA_DIR=/app/data
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MARKET_DATA_PROVIDER=synthetic
# alphavantage requires adjusted daily full-history entitlement.
MARKET_DATA_API_KEY=
REDIS_URL=
# Production authentication. Use APP_MODE=production and PostgreSQL together.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional PRIVATE bucket; required for durable storage on ephemeral hosts.
SUPABASE_STORAGE_BUCKET=
RESEARCH_PROVIDER=curated
# Set RESEARCH_PROVIDER=openrouter and LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Or use RESEARCH_PROVIDER=openai with a Responses/web-search compatible model.
LLM_API_KEY=
LLM_MODEL=
# Single configured paper account, restricted to this authenticated Supabase user.
PAPER_TRADING_ENABLED=false
PAPER_OWNER_USER_ID=
ALPACA_API_KEY=
ALPACA_API_SECRET=
